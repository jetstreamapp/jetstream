{
  "$schema": "./node_modules/release-it/schema/release-it.json",
  "plugins": {
    "@release-it/bumper": {
      "in": "package.json",
      "out": "package.json"
    }
  },
  "git": {
    "commitMessage": "chore: release ${version}",
    "tag": true,
    "tagName": "v${version}",
    "pushArgs": ["--follow-tags", "--atomic"],
    "requireBranch": ["main", "hotfix/*"]
  },
  "npm": false,
  "github": {
    "release": true,
    "releaseName": "Jetstream ${version}",
    "autoGenerate": true
  },
  "hooks": {
    "before:init": "if [ \"$CI\" != \"true\" ]; then echo 'Local releases are disabled; run releases via CI only.'; exit 1; fi",
    "after:bump": "pnpm oxfmt package.json",
    "after:release": "echo Successfully released ${name} v${version}."
  }
}
