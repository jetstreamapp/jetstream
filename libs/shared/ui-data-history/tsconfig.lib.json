    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "references": [
    {
      "path": "../../desktop-types/tsconfig.lib.json"
    },
    {
      "path": "../data/tsconfig.lib.json"
    },
    {
      "path": "../utils/tsconfig.lib.json"
    },
    {
      "path": "../client-logger/tsconfig.lib.json"
    },
    {
      "path": "../ui-db/tsconfig.lib.json"
    },
    {
