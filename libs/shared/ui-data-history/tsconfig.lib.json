{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/shared/ui-data-history",
    "declaration": true,
    "types": ["node", "google.accounts", "google.picker", "gapi.auth2"]
  },
  "include": ["src/**/*.ts", "../../../custom-typings/index.d.ts", "../../../custom-typings/electron.d.ts"],
  "exclude": [
    "src/test-setup.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
