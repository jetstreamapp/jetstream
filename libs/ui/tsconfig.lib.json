{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/libs/ui",
    "types": ["node", "google.accounts", "google.picker", "gapi.auth2"]
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "files": [
    "../../node_modules/@nx/react/typings/cssmodule.d.ts",
    "../../node_modules/@nx/react/typings/image.d.ts",
    "../../custom-typings/index.d.ts"
  ],
  "references": [
    {
      "path": "../auth/types/tsconfig.lib.json"
    },
    {
      "path": "../shared/ui-db/tsconfig.lib.json"
    },
    {
      "path": "../test-utils/tsconfig.lib.json"
    },
    {
      "path": "../shared/ui-app-state/tsconfig.lib.json"
    },
    {
      "path": "../desktop-types/tsconfig.lib.json"
    },
    {
      "path": "../shared/ui-router/tsconfig.lib.json"
    },
    {
      "path": "../shared/utils/tsconfig.lib.json"
    },
    {
      "path": "../shared/data/tsconfig.lib.json"
    },
    {
      "path": "../shared/constants/tsconfig.lib.json"
    },
    {
      "path": "../shared/ui-utils/tsconfig.lib.json"
    },
    {
      "path": "../shared/client-logger/tsconfig.lib.json"
    },
    {
      "path": "../icon-factory/tsconfig.lib.json"
    },
    {
      "path": "../types/tsconfig.lib.json"
    }
  ]
}
