{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "outDir": "../../dist/out-tsc/apps/geo-ip-api",
    "types": ["node", "express", "google.accounts", "google.picker", "gapi.auth2"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "references": [
    {
      "path": "../../libs/types/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api-config/tsconfig.lib.json"
    }
  ]
}
