{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "../../dist/out-tsc/apps/jetstream-e2e",
    "module": "commonjs",
    "sourceMap": false
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "playwright.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "../../libs/shared/utils"
    },
    {
      "path": "../../libs/prisma"
    },
    {
      "path": "../../libs/auth/types"
    },
    {
      "path": "../../libs/auth/server"
    },
    {
      "path": "../../libs/shared/constants"
    },
    {
      "path": "../../libs/types"
    },
    {
      "path": "../../libs/api-types"
    },
    {
      "path": "../../libs/api-config"
    },
    {
      "path": "../../libs/test/e2e-utils"
    }
  ],
  "exclude": ["eslint.config.js"]
}
