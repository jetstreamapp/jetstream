{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/apps/jetstream-desktop",
    "types": ["node", "google.accounts", "google.picker", "gapi.auth2"]
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "include": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "../../custom-typings/index.d.ts", "../../custom-typings/electron.d.ts"],
  "files": ["../../node_modules/@nx/react/typings/cssmodule.d.ts", "../../node_modules/@nx/react/typings/image.d.ts"],
  "references": [
    {
      "path": "../../libs/auth/salesforce-oauth/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api-types/tsconfig.lib.json"
    },
    {
      "path": "../../libs/salesforce-api/tsconfig.lib.json"
    },
    {
      "path": "../../libs/types/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/utils/tsconfig.lib.json"
    },
    {
      "path": "../../libs/desktop-types/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/constants/tsconfig.lib.json"
    }
  ]
}
