{
  "name": "jetstream-web-extension",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/jetstream-web-extension/src",
  "projectType": "application",
  "tags": ["scope:browser"],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/apps/jetstream-web-extension"],
      "defaultConfiguration": "production",
      "configurations": {
        "development": {
          "mode": "development"
        },
        "staging": {
          "mode": "staging"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "continuous": true,
      "command": "nx build jetstream-web-extension --configuration=development --watch"
    }
  }
}
