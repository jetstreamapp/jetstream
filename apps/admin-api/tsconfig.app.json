{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "outDir": "../../dist/out-tsc/apps/admin-api",
    "types": ["node", "express"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "references": [
    {
      "path": "../../libs/shared/utils/tsconfig.lib.json"
    },
    {
      "path": "../../libs/prisma/tsconfig.lib.json"
    },
    {
      "path": "../../libs/auth/server/tsconfig.lib.json"
    },
    {
      "path": "../../libs/team-seats/tsconfig.lib.json"
    },
    {
      "path": "../../libs/email/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/constants/tsconfig.lib.json"
    },
    {
      "path": "../../libs/audit-logs/tsconfig.lib.json"
    },
    {
      "path": "../../libs/types/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api-config/tsconfig.lib.json"
    },
    {
      "path": "../../libs/admin/types/tsconfig.lib.json"
    }
  ]
}
