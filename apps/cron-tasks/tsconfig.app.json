{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "outDir": "../../dist/out-tsc/apps/cron-tasks",
    "target": "esnext",
    "types": ["node", "google.accounts", "google.picker", "gapi.auth2"],
    "jsx": "react"
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "include": ["**/*.ts"],
  "references": [
    {
      "path": "../../libs/shared/constants/tsconfig.lib.json"
    },
    {
      "path": "../../libs/types/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/utils/tsconfig.lib.json"
    },
    {
      "path": "../../libs/audit-logs/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api-config/tsconfig.lib.json"
    },
    {
      "path": "../../libs/email/tsconfig.lib.json"
    },
    {
      "path": "../../libs/prisma/tsconfig.lib.json"
    }
  ]
}
