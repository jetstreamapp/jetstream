#!/bin/sh
# Format and lint the whole workspace. oxfmt/oxlint scan all 4k files in a couple of seconds, so
# there is no need to narrow this to staged files (and doing so would risk rewriting or missing
# partially-staged hunks).
#
# Both are read-only: they report and fail, they never rewrite your working tree. Run
# `pnpm format` / `pnpm lint:fix` to fix, or `git commit --no-verify` to bypass.

# enforce-module-boundaries silently skips when Nx's project graph cache is missing, so make sure
# it exists before linting. A failure here means the boundary rule cannot run at all, so fail
# loudly instead of letting oxlint pass without it (CI's lint job does the same).
nx_graph_output=$(pnpm nx show projects 2>&1) || {
  echo "$nx_graph_output"
  echo ""
  echo "Failed to compute the Nx project graph, so nx/enforce-module-boundaries cannot run."
  echo "Fix the error above, or use 'git commit --no-verify' to bypass."
  exit 1
}

pnpm exec oxfmt --check . || {
  echo ""
  echo "Formatting issues found. Run 'pnpm format' to fix."
  exit 1
}

pnpm exec oxlint --quiet . || {
  echo ""
  echo "Lint errors found. Run 'pnpm lint:fix' to auto-fix what can be fixed."
  exit 1
}

# Accessibility ratchet: new warn-tier jsx-a11y hits, new libs/ui specs without axeScan(), and new
# routes without an axe baseline entry (scripts/a11y-lint-ratchet.mjs).
pnpm a11y:lint-ratchet || {
  echo ""
  echo "Accessibility ratchet failed. See the messages above, or use 'git commit --no-verify' to bypass."
  exit 1
}
